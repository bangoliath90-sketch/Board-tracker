{
  "expo": {
    "name": "Board Tracker",
    "slug": "board-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_CONTACTS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "package": "com.boardtracker.pegboard"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Board Tracker uses Face ID to keep your board locked."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Board Tracker lets you pick a person and their phone number from your contacts."
        }
      ],
      "expo-notifications"
    ],
    "scheme": "boardtracker",
    "experiments": {
      "typedRoutes": false
    },
    "owner": "kingkarma12s-team",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "973c30f2-6ea6-494d-8a0d-f4e5e53ecf07"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/973c30f2-6ea6-494d-8a0d-f4e5e53ecf07"
    }
  }
}
